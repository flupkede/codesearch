<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>scip-csharp</AssemblyName>
    <RootNamespace>ScipCsharp</RootNamespace>
    <!-- Kept in sync with Cargo.toml by scripts/bump-version.sh: the
         version line the helper prints is how a deployed helper proves
         which build it is (a stale helper is otherwise invisible). -->
    <Version>1.8.21</Version>
    <!-- Self-contained single-file: RuntimeIdentifier is set per publish invocation -->
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!--
      IncludeAllContentForSelfExtract is REQUIRED. Microsoft.Build.Locator and
      Microsoft.CodeAnalysis.MSBuild use Assembly.Location to discover MSBuild
      assemblies on disk. In a single-file publish, Assembly.Location is empty
      for bundled assemblies, which causes MSBuildWorkspace.OpenSolutionAsync()
      to throw `ArgumentNullException: Value cannot be null. (Parameter 'path1')`
      from a Path.Combine call inside MSBuild's loader. Forcing all content
      (managed + native) to self-extract gives every assembly a real on-disk
      path. Trade-off: slightly slower first-run startup; correctness wins.
    -->
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis" Version="4.13.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.13.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="4.13.0" />
    <PackageReference Include="Microsoft.Build.Locator" Version="1.9.1" />
    <!--
      Aikido 59399549 (CVE-2025-26646): direct reference wins over the
      vulnerable transitive 17.7.2 from Workspaces.MSBuild (NuGet nearest-wins).
      Roslyn itself stays pinned at 4.13.0 for .NET 10 compatibility.
    -->
    <PackageReference Include="Microsoft.Build.Tasks.Core" Version="17.14.8" ExcludeAssets="runtime" />
    <!--
      NU1903 suppress: remaining Microsoft.Build.Tasks.Core transitive advisories
      (GHSA-h4j7-5rxr-p4wc, GHSA-w3q9-fxm7-j8fq) target the DownloadFile MSBuild
      task, which we never use. Our scip-csharp runs locally as a subprocess, no
      network-facing attack surface.
    -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-h4j7-5rxr-p4wc" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-w3q9-fxm7-j8fq" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-37gx-xxp4-5rgx" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-w3x6-4m5h-cxqf" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
    <None Include="tests/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- KeyFormatTests exercise the internal key-building helpers directly. -->
    <InternalsVisibleTo Include="ScipCsharp.Tests" />
  </ItemGroup>

</Project>
