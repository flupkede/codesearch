<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.*" />
    <PackageReference Include="xunit" Version="2.*" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.*" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.13.0" />
    <!-- SymbolIndexer.cs declares `using Microsoft.CodeAnalysis.MSBuild;`
         (MSBuildWorkspace), which only resolves with the Workspaces.MSBuild
         assembly on the reference set. -->
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="4.13.0" />
    <!-- MSBuildWorkspace needs the C# language services (CSharp.Workspaces)
         to map .csproj files to the C# language; without it OpenProjectAsync
         fails with "the language 'C#' is not supported". -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.13.0" />
    <!-- GeneratorSupportTests registers the real .NET SDK MSBuild so the
         Blazor fixture loads with its Razor generator references intact. -->
    <PackageReference Include="Microsoft.Build.Locator" Version="1.9.1" />
    <!-- Same transitive-CVE suppressions as scip-csharp.csproj (never-used
         DownloadFile task surface). -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-h4j7-5rxr-p4wc" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-w3q9-fxm7-j8fq" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-37gx-xxp4-5rgx" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-w3x6-4m5h-cxqf" />
  </ItemGroup>

  <!--
    Model tests need no Roslyn; KeyFormatTests drives the real SymbolIndexer
    over in-memory compilations, so Roslyn is referenced and SymbolIndexer.cs
    is compiled in (its internals are visible via InternalsVisibleTo).
  -->
  <ItemGroup>
    <Compile Include="..\ScipModels.cs" Link="ScipModels.cs" />
    <Compile Include="..\OutputWriter.cs" Link="OutputWriter.cs" />
    <Compile Include="..\SymbolIndexer.cs" Link="SymbolIndexer.cs" />
    <Compile Include="..\GeneratorSupport.cs" Link="GeneratorSupport.cs" />
    <Compile Include="..\WorkspaceLoad.cs" Link="WorkspaceLoad.cs" />
    <Compile Include="..\WorkspaceNoise.cs" Link="WorkspaceNoise.cs" />
    <Compile Include="..\RestorePolicy.cs" Link="RestorePolicy.cs" />
  </ItemGroup>

  <!-- Exclude fixture source files from compilation -->
  <ItemGroup>
    <Compile Remove="Fixtures\**\*.cs" />
    <None Include="Fixtures\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
